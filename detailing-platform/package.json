{
  "name": "detailing-booking-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "//— конвейер студий (работает без установки зависимостей) —": "",
    "tenant:new": "node scripts/pipeline/tenant-new.mjs",
    "tenant:validate": "node scripts/pipeline/tenant-validate.mjs",
    "tenant:publish": "node scripts/pipeline/tenant-publish.mjs",
    "tenant:verify": "node scripts/pipeline/tenant-verify.mjs",

    "//— база данных —": "",
    "db:reset": "bash scripts/db-reset.sh",
    "db:test": "bash scripts/db-test.sh",
    "db:test:concurrency": "bash scripts/test-concurrency.sh",

    "//— приложение (требует pnpm install) —": "",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "@tanstack/react-query": "5.59.0",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "liquid-gl": "0.3.2",
    "phosphor-react": "1.4.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "6.27.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.48.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "4.3.2",
    "typescript": "5.6.3",
    "vite": "5.4.8",
    "vite-plugin-pwa": "0.20.5",
    "vitest": "2.1.2",
    "workbox-window": "7.1.0"
  }
}
